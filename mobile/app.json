{
  "expo": {
    "name": "Paneltec Group Field",
    "slug": "paneltec-civil-field",
    "version": "1.0.25",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "scheme": "paneltec",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.whscompliance.fv5aib",
      "buildNumber": "147"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.emergent.whscompliance.fv5aib",
      "versionCode": 147
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native",
        {
          "autoUpload": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df0c866d-b261-4aff-a724-afdd6420389a"
      }
    },
    "owner": "stephenguy",
    "runtimeVersion": "1.0.18",
    "updates": {
      "url": "https://u.expo.dev/df0c866d-b261-4aff-a724-afdd6420389a"
    },
    "splash": {
      "image": "./assets/icons/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}
