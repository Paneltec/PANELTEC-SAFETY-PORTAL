{
  "expo": {
    "name": "Paneltec Civil Field",
    "slug": "paneltec-civil-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "scheme": "paneltec",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Scan QR codes and capture hazard photos",
        "NSPhotoLibraryUsageDescription": "Attach site photos to reports",
        "NSFaceIDUsageDescription": "Sign in quickly with Face ID",
        "NSLocationWhenInUseUsageDescription": "Capture GPS for site sign-on"
      },
      "bundleIdentifier": "com.emergent.whscompliance.fv5aib"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "com.emergent.whscompliance.fv5aib"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-router",
      "expo-image-picker",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Sign in quickly with Face ID"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Capture GPS for site sign-on"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan QR codes for crew sign-on"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
