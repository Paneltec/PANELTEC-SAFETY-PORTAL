{
  "expo": {
    "name": "Paneltec Group Field",
    "slug": "paneltec-civil-field",
    "version": "1.0.72",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "scheme": ["paneltec-mobile", "paneltec"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.paneltec.whs",
      "buildNumber": "187",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Scan QR codes for site sign-on and vehicle ID",
        "NSPhotoLibraryUsageDescription": "Attach photos to hazard and incident reports",
        "NSLocationWhenInUseUsageDescription": "Show your location on the site map"
      },
      "associatedDomains": [
        "applinks:whs-compliance.preview.emergentagent.com",
        "applinks:paneltec.com.au",
        "applinks:app.paneltec.com.au"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.paneltec.whs",
      "permissions": [
        "android.permission.RECEIVE_SMS",
        "android.permission.READ_SMS"
      ],
      "versionCode": 194,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "whs-compliance.preview.emergentagent.com", "pathPrefix": "/scan" },
            { "scheme": "https", "host": "whs-compliance.preview.emergentagent.com", "pathPrefix": "/onboard" },
            { "scheme": "https", "host": "whs-compliance.preview.emergentagent.com", "pathPrefix": "/manuals" },
            { "scheme": "https", "host": "paneltec.com.au", "pathPrefix": "/scan" },
            { "scheme": "https", "host": "paneltec.com.au", "pathPrefix": "/onboard" },
            { "scheme": "https", "host": "app.paneltec.com.au", "pathPrefix": "/scan" },
            { "scheme": "https", "host": "app.paneltec.com.au", "pathPrefix": "/onboard" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icons/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native",
        {
          "autoUpload": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      ["./plugins/expo-sms-receiver/app.plugin.js", { "senderFilter": "Paneltec01" }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "df0c866d-b261-4aff-a724-afdd6420389a"
      }
    },
    "owner": "stephenguy",
    "runtimeVersion": "1.0.18",
    "updates": {
      "url": "https://u.expo.dev/df0c866d-b261-4aff-a724-afdd6420389a"
    },
    "splash": {
      "image": "./assets/icons/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    }
  }
}