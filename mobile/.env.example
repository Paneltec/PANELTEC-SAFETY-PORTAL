# Paneltec Civil — Expo mobile environment (template)
# Copy this to `.env` and fill in real values. NEVER commit the real .env.

EXPO_TUNNEL_SUBDOMAIN=your-app-subdomain
EXPO_PACKAGER_HOSTNAME=https://your-preview-host.example.com
EXPO_PUBLIC_BACKEND_URL=https://your-backend-host.example.com
EXPO_PACKAGER_PROXY_URL=https://your-app.expo.preview.example.com
EXPO_USE_FAST_RESOLVER="1"
METRO_CACHE_ROOT=/app/mobile/.metro-cache

# ngrok tunnel — required only when running Metro over the public internet.
NGROK_AUTHTOKEN="<REPLACE — from https://dashboard.ngrok.com/get-started/your-authtoken>"
