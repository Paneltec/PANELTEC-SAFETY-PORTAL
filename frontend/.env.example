# Paneltec Civil — web frontend environment (template)
# Copy this to `.env` and fill in real values. NEVER commit the real .env.

REACT_APP_BACKEND_URL=https://your-backend-host.example.com
WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false

# v58.13.132lc — CRA webpack heap ceiling. This is layer 2 of a 3-layer
# persistence net (also in package.json scripts + supervisord.conf).
# Bumped from 1024→4096 after the .132kz OOM crashes.
NODE_OPTIONS=--max-old-space-size=4096
