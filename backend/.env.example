# Paneltec Civil — backend environment (template)
# Copy this to `.env` and fill in real values. NEVER commit the real .env.

# --- MongoDB ---
MONGO_URL="mongodb://localhost:27017"
DB_NAME="paneltec_dev"

# --- Auth / CORS ---
# Generate a fresh 64-char hex for each environment.
JWT_SECRET="<REPLACE — run: python -c \"import secrets; print(secrets.token_hex(32))\">"
CORS_ORIGINS="*"

# --- Emergent Universal LLM Key ---
# From: Emergent Profile → Universal Key. Do not share.
EMERGENT_LLM_KEY="<REPLACE — sk-emergent-…>"

# --- Object storage (Tigris — optional) ---
TIGRIS_ENDPOINT="http://localhost:8085"
TIGRIS_ACCESS_KEY_ID=""
TIGRIS_SECRET_ACCESS_KEY=""
TIGRIS_BUCKET="default-bucket"

# --- Dev seed / demo ---
DEMO_PASSWORD="demo123"
FRONTEND_PUBLIC_URL="https://your-preview-host.example.com"

# --- Communications safe mode ---
# `on` disarms all outbound M365/TextMagic sends. Turn `off` only in staging/prod.
COMMS_SAFE_MODE=on

# --- v160.3.9.58 · Bulk-import Pre-Starts pipeline ---
# --- v160.3.9.58.0.1 · scaling knobs for a real 10k+ PDF backfill ---
#
# Stage-specific watchdog timeouts. The watchdog runs every 60 s;
# stuck jobs are marked `state=failed` with a matching `error_step`.
#   · downloading  → ceiling BEFORE any progress signal is available.
#   · extracting   → walker enumeration ceiling.
#   · vision       → *stall* detection — keys off `last_progress_at`
#                    (delta since last `processed` increment), NOT
#                    wall-clock. A 4-hour job that steadily increments
#                    is healthy and will NOT be reaped.
BULK_IMPORT_DOWNLOAD_TIMEOUT_MIN=10
BULK_IMPORT_EXTRACT_TIMEOUT_MIN=30
BULK_IMPORT_VISION_STALL_TIMEOUT_MIN=15
#
# Zip-bomb guardrails — trip `error_step=extract_limit` if breached.
# Sized for the intentional 10 000+ PDF back-fill; still safe.
BULK_IMPORT_MAX_ENTRIES=15000
BULK_IMPORT_MAX_UNPACKED_MB=20000
BULK_IMPORT_MAX_SINGLE_ENTRY_MB=100
#
# Jobs older than this are pruned nightly (03:00 Sydney).
BULK_IMPORT_RETENTION_DAYS=30
#
# Vision (Claude) concurrency + retry. 4 in-flight vision calls balances
# throughput against Anthropic rate limits. Exponential backoff on
# 429/5xx with max retries below.
BULK_IMPORT_VISION_CONCURRENCY=4
BULK_IMPORT_VISION_MAX_RETRIES=5
BULK_IMPORT_VISION_BACKOFF_CAP_SEC=30
#
# Rough per-call cost estimate used to populate
# `job.progress.estimated_cost_usd`. Two Claude calls per PDF
# (classify + extract) at ~$0.003 each ≈ $0.006. Tune to your plan.
BULK_IMPORT_VISION_PER_PDF_COST_USD=0.006
#
# Progress-write cadence — batching keeps Mongo write pressure sane on
# a 10k-PDF run. Writes happen every N PDFs OR every M seconds,
# whichever hits first.
BULK_IMPORT_PROGRESS_EVERY_N=25
BULK_IMPORT_PROGRESS_EVERY_SEC=5
#
# Producer/consumer queue depth. Keeps memory flat regardless of the
# archive size — 32 × ~1 MB average PDF ≈ 32 MB ceiling.
BULK_IMPORT_QUEUE_MAXSIZE=32
#
# PDF hash cache TTL. Enables cheap resume of a failed run — the
# nightly retention sweep clears cache rows older than this.
BULK_IMPORT_PDF_CACHE_TTL_DAYS=30
#
# WARN log threshold — signals ops a "big" job is running.
BULK_IMPORT_BIG_JOB_LOG_THRESHOLD=5000
